

-- Таблица сотрудников (пользователей)
CREATE TABLE employees (
    id SERIAL PRIMARY KEY,
    username VARCHAR(50) UNIQUE NOT NULL,
    password_hash VARCHAR(255) NOT NULL,
    role VARCHAR(20) NOT NULL DEFAULT 'auditor'
);

-- Справочник типов уязвимостей
CREATE TABLE vulnerability_types (
    id SERIAL PRIMARY KEY,
    name VARCHAR(100) NOT NULL,
    base_risk_score INTEGER NOT NULL
);

-- Журнал инцидентов
CREATE TABLE incidents (
    id SERIAL PRIMARY KEY,
    employee_id INTEGER REFERENCES employees(id) ON DELETE SET NULL,
    vulnerability_type_id INTEGER REFERENCES vulnerability_types(id) ON DELETE RESTRICT,
    description TEXT NOT NULL,
    status VARCHAR(50) DEFAULT 'Зафиксирован',
    severity_score NUMERIC, -- Будет вычисляться автоматически
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- Функция для расчета уровня критичности (базовый риск * коэффициент)
CREATE OR REPLACE FUNCTION calculate_severity()
RETURNS TRIGGER AS $$
DECLARE
    base_score INTEGER;
BEGIN
    -- Получаем базовый риск из справочника
    SELECT base_risk_score INTO base_score
    FROM vulnerability_types
    WHERE id = NEW.vulnerability_type_id;

    -- Допустим, коэффициент влияния = 1.5
    NEW.severity_score := base_score * 1.5;
    
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

-- Триггер, который срабатывает ДО вставки новой записи
CREATE TRIGGER set_incident_severity
BEFORE INSERT ON incidents
FOR EACH ROW
EXECUTE FUNCTION calculate_severity();

